#
# Configuración del Nodo Nacional (Broker)
# Este nodo maneja el Servidor Nacional con patrón Broker
#

# Configuración del Registry
Ice.Default.Locator=DemoIceGrid/Locator:default -h localhost -p 4061

# Configuración del Nodo Nacional
IceGrid.Node.Name=nodeNacional
IceGrid.Node.Endpoints=tcp -h localhost -p 4063
IceGrid.Node.Data=data/nodeNacional
IceGrid.Node.Output=logs
IceGrid.Node.RedirectErrToOut=1


# Configuración de logging
Ice.Trace.Network=0
Ice.Trace.Protocol=0
Ice.Warn.Connections=1


# Configuración de threading para el Broker (más threads)
# Esta es la forma recomendada para evitar warnings.
IceGrid.Node.ThreadPool.Size=20
IceGrid.Node.ThreadPool.SizeMax=200

# Configuración específica del Broker
Broker.UmbralEscalado=50.0
Broker.UmbralReduccion=20.0
Broker.MaxReplicas=10
Broker.IntervaloEvaluacion=15

# ========================================
# Configuración del ReliableMessageQueue
# ========================================

# Directorio base para la cola confiable
ReliableQueue.BaseDir=reliable_queue

# Configuración de procesamiento
ReliableQueue.ProcessingInterval=5000
ReliableQueue.BatchSize=50
ReliableQueue.MaxRetries=3
ReliableQueue.RetryDelay=10000

# Configuración de threads
ReliableQueue.ProcessingThreads=5
ReliableQueue.SchedulerThreads=2

# Configuración de persistencia
ReliableQueue.PersistenceEnabled=1
ReliableQueue.AutoCleanup=1
ReliableQueue.CleanupInterval=3600000
ReliableQueue.MaxProcessedFiles=1000

# Configuración de logging específico para la cola
ReliableQueue.LogLevel=DEBUG
ReliableQueue.LogStatistics=1
ReliableQueue.StatisticsInterval=30000

# Configuración de base de datos para votos
VotosDB.ConnectionTimeout=5000
VotosDB.MaxRetries=3
VotosDB.RetryInterval=2000 