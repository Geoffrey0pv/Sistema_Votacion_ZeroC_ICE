<icegrid>

  <application name="SistemaVotacion">

    <!-- Definición de la variable para que todos los servidores la puedan usar -->
    <variable name="ice.default.locator" value="DemoIceGrid/Locator:tcp -h localhost -p 4061"/>

    <!-- Nodo para Servidor Regional -->
    <node name="nodeRegional">
      <server id="RegionalServer" exe="java" activation="always">
        <option>-jar</option>
        <option>../servidorRegional/build/libs/servidorRegional.jar</option>
        <adapter name="ServidorRegionalAdapter" endpoints="tcp -p 10001">
          <object identity="CargarCandidatos" type="::Demo::ICargarCandidatos"/>
          <object identity="ReceptorVotosRegional" type="::Demo::IReceptorVotosRegional"/>
          <object identity="receptorVotos" type="::Demo::IRegistrarVoto"/>
        </adapter>
        <properties>
          <!-- Propiedades para la conexión DIRECTA al Servidor Nacional -->
          <property name="RegistroVotos.Proxy" value="RegistroVotos:tcp -h localhost -p 10002"/>
          <property name="ConsultaCandidatos.Proxy" value="ConsultaCandidatos:tcp -h localhost -p 10002"/>
          <property name="ConsultaCiudadanos.Proxy" value="ConsultaCiudadanos:tcp -h localhost -p 10002"/>

          <!-- Propiedades heredadas de IceGrid -->
          <property name="Ice.Default.Locator" value="${ice.default.locator}"/>
          <property name="Ice.Default.Package" value="Demo"/>
          <property name="Replica.Id" value="1"/>
          <property name="Replica.Port" value="9090"/>
          
          <!-- Configuración del ReliableMessageQueue -->
          <property name="ReliableQueue.BaseDir" value="reliable_queue_1"/>
          <property name="ReliableQueue.ProcessingInterval" value="5000"/>
          <property name="ReliableQueue.BatchSize" value="50"/>
          <property name="ReliableQueue.MaxRetries" value="3"/>
          <property name="ReliableQueue.RetryDelay" value="10000"/>
          <property name="ReliableQueue.ProcessingThreads" value="5"/>
          <property name="ReliableQueue.SchedulerThreads" value="2"/>
          <property name="ReliableQueue.PersistenceEnabled" value="1"/>
          <property name="ReliableQueue.AutoCleanup" value="1"/>
          <property name="ReliableQueue.CleanupInterval" value="3600000"/>
          <property name="ReliableQueue.MaxProcessedFiles" value="1000"/>
          <property name="ReliableQueue.LogLevel" value="DEBUG"/>
          <property name="ReliableQueue.LogStatistics" value="1"/>
          <property name="ReliableQueue.StatisticsInterval" value="30000"/>
          
          <!-- Configuración de base de datos para votos -->
          <property name="VotosDB.ConnectionTimeout" value="5000"/>
          <property name="VotosDB.MaxRetries" value="3"/>
          <property name="VotosDB.RetryInterval" value="2000"/>
        </properties>
      </server>
    </node>

    <!-- Nodo para Servidor Nacional (Broker) -->
    <node name="nodeNacional">
      <server id="ServidorNacional" exe="java" activation="always">
        <option>-jar</option>
        <option>../servidorNacional/build/libs/servidorNacional.jar</option>
        <adapter name="ServidorNacionalAdapter" endpoints="tcp -p 10002">
          <object identity="ConsultaCiudadanos" type="::Demo::IConsultaCiudadanos"/>
          <object identity="RegistroVotos" type="::Demo::IRegistroVotos"/>
        </adapter>
        <properties>
          <property name="Ice.Default.Package" value="Demo"/>
          
          <!-- Configuración del ReliableMessageQueue -->
          <property name="ReliableQueue.BaseDir" value="reliable_queue"/>
          <property name="ReliableQueue.ProcessingInterval" value="5000"/>
          <property name="ReliableQueue.BatchSize" value="50"/>
          <property name="ReliableQueue.MaxRetries" value="3"/>
          <property name="ReliableQueue.RetryDelay" value="10000"/>
          <property name="ReliableQueue.ProcessingThreads" value="5"/>
          <property name="ReliableQueue.SchedulerThreads" value="2"/>
          <property name="ReliableQueue.PersistenceEnabled" value="1"/>
          <property name="ReliableQueue.AutoCleanup" value="1"/>
          <property name="ReliableQueue.CleanupInterval" value="3600000"/>
          <property name="ReliableQueue.MaxProcessedFiles" value="1000"/>
          <property name="ReliableQueue.LogLevel" value="DEBUG"/>
          <property name="ReliableQueue.LogStatistics" value="1"/>
          <property name="ReliableQueue.StatisticsInterval" value="30000"/>
          
          <!-- Configuración de base de datos para votos -->
          <property name="VotosDB.ConnectionTimeout" value="5000"/>
          <property name="VotosDB.MaxRetries" value="3"/>
          <property name="VotosDB.RetryInterval" value="2000"/>
        </properties>
      </server>
    </node>

    <service-template id="BrokerService">
      <service name="AdministradorCandidatos" entry="ServidorNacionalAdapter.AdministradorCandidatos" />
      <service name="BrokerNacional" entry="ServidorNacionalAdapter.BrokerNacional" />
      <service name="HelloWorld" entry="ServidorNacionalAdapter.HelloWorld" />
      <service name="MonitorRecursos" entry="ServidorNacionalAdapter.MonitorRecursos" />
      <service name="BalanceadorCarga" entry="ServidorNacionalAdapter.BalanceadorCarga" />
      <service name="GestorReplicas" entry="ServidorNacionalAdapter.GestorReplicas" />
      <service name="VotosService" entry="ServidorNacionalAdapter.VotosService" />
    </service-template>

  </application>
</icegrid>
