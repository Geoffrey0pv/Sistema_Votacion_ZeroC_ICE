#
# Configuración del Nodo Regional
# Este nodo maneja el Servidor Regional
#

# Configuración del Registry
Ice.Default.Locator=DemoIceGrid/Locator:default -h localhost -p 4061

# Configuración del Nodo Regional
IceGrid.Node.Name=nodeRegional
IceGrid.Node.Endpoints=tcp -h localhost -p 4062
IceGrid.Node.Data=data/nodeRegional
IceGrid.Node.Output=logs
IceGrid.Node.RedirectErrToOut=1

# Configuración de logging
Ice.Trace.Network=1
Ice.Trace.Protocol=1
Ice.Warn.Connections=1

# Configuración de threading
Ice.ThreadPool.Server.Size=10
Ice.ThreadPool.Server.SizeMax=100 